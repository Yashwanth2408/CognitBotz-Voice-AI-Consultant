# ──────────────────────────────────────────────
# CognitBotz Voice AI — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to voice_agent/.env and fill in your values.

GROQ_API_KEY=gsk_your_groq_api_key_here

# Offline TTS (no Edge/cloud)
TTS_ENGINE=mms
TTS_MMS_MODEL_ID=onecxi/mms-english-female-indic
TTS_MODEL_PATH=voice_agent/assets/voices/en_IN-spicor-medium.onnx
TTS_AUTO_DOWNLOAD=true
